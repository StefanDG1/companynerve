{
  "name": "companynerve",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @companynerve/starter dev",
    "dev:marketing": "pnpm --filter @companynerve/marketing dev",
    "build": "pnpm --filter @companynerve/marketing build && pnpm --filter @companynerve/starter build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "check": "pnpm validate && pnpm typecheck && pnpm test && pnpm build",
    "convex:dev": "convex dev",
    "template:export": "node scripts/export-template.mjs",
    "format": "prettier --write .",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@workos-inc/node": "10.7.0",
    "convex": "1.45.0",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "24.13.3",
    "convex-test": "0.0.56",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "8.0.3",
    "vitest": "5.0.0"
  }
}
