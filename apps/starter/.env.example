# Use this product's own WorkOS environment; never inherit suite credentials.
# In WorkOS: enable Magic Auth email codes + Google, disable email/password
# and all other sign-in methods. Environment values do not apply that policy.
# Store this product's Google OAuth client credentials in WorkOS, not here.
NEXT_PUBLIC_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Session encryption secret (32+ random characters), not a user login password.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback
APP_URL=http://localhost:3001
